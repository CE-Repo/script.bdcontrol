msgid "Keymap file contents"
msgstr "Inhalt der Tastenbelegungsdatei"

msgctxt "#30127"
msgid "Note: long press only fires when the remote driver reports a held key. If it does not work, assign the button again and choose a short press."
msgstr "Hinweis: Langes Drücken funktioniert nur, wenn der Fernbedienungstreiber eine gehaltene Taste meldet. Falls es nicht klappt, die Taste erneut zuweisen und kurzes Drücken wählen."

msgctxt "#30128"
msgid "Remote configuration"
msgstr "Fernbedienungs-Konfiguration"

msgctxt "#30129"
msgid "no repeat settings found"
msgstr "keine Repeat-Einstellungen gefunden"

msgctxt "#30130"
msgid "none found"
msgstr "keine gefunden"

