msgid "Assign the button for the disc menu"
msgstr "Taste für das Disc-Menü zuweisen"

msgctxt "#30229"
msgid "Clear all assignments"
msgstr "Alle Zuweisungen löschen"

msgctxt "#30223"
msgid "Separate popup and top menu entries"
msgstr "Getrennte Einträge für Popup- und Hauptmenü"

msgctxt "#30226"
msgid "Show recent key presses from the log"
msgstr "Zuletzt gedrückte Tasten aus dem Log anzeigen"

