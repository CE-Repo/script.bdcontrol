    <control type="image" id="1">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <visible>String.IsEqual(Window(10000).Property(BDControl.DimVisible),1)</visible>
      <texture colordiffuse="$INFO[Window(10000).Property(BDControl.DimColor)]">bd-dim.png</texture>
      <animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
      <animation effect="fade" start="100" end="0" time="150">WindowClose</animation>
    </control>

    <control type="group" id="2">
      <left>278</left>
      <top>902</top>
      <!-- Nothing is drawn until dialog.py has moved the panel to the
           position the settings ask for: the window file can only name one
           position, and the panel would otherwise show at that one for a
           frame and then jump to the real one. Opening therefore hangs off
           this becoming true rather than off the window opening. -->
      <visible>String.IsEqual(Window(10000).Property(BDControl.Placed),1)</visible>
      <animation effect="slide" start="0,120" end="0,0" time="200" tween="quadratic" easing="out">Visible</animation>
      <animation effect="slide" start="0,0" end="0,120" time="150" tween="quadratic" easing="in">WindowClose</animation>
      <animation effect="fade" start="0" end="100" time="200">Visible</animation>
      <animation effect="fade" start="100" end="0" time="150">WindowClose</animation>

      <!-- Chapter tab, resting on the panel's top right corner. Its lower
           edge stops exactly where the panel begins rather than running on
           underneath: two translucent shapes over each other double up their
           colour, which showed as a dark block once the panel transparency
           was turned down. Its texture is rounded along the top and square
           along the bottom, so the join with the panel reads as one shape at
           any transparency. The text comes straight from a window property,
           so the tab can hide itself when there is no chapter to show. -->
      <control type="group">
        <visible>!String.IsEmpty(Window(10000).Property(BDControl.Chapter))</visible>
        <control type="image">
          <left>1163</left>
          <top>-30</top>
