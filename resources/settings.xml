<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
  <section id="script.bdcontrol">

    <category id="general" label="30200">
      <group id="1">
        <setting id="show_hint" type="boolean" label="30201">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="auto_open" type="boolean" label="30202" help="30262">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="osd_timeout" type="integer" label="30203">
          <level>0</level>
          <default>10</default>
          <constraints>
            <minimum>0</minimum>
            <step>1</step>
            <maximum>60</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="extended_disc_menus" type="boolean" label="30223" help="30263">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="seek_step" type="integer" label="30204">
          <level>0</level>
          <default>30</default>
          <constraints>
            <minimum>5</minimum>
            <step>5</step>
            <maximum>300</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
      </group>
    </category>

